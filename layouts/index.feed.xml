{{- /* RSS at /feed.xml for the self-hosted site, posts only. Named for its own
     output format so it never replaces micro.blog's feed.xml */ -}}
{{- $posts := first 20 ((where site.RegularPages "Type" "post").ByDate.Reverse) -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ "/" | absURL }}</link>
    <description>{{ site.Params.description }}</description>
    <language>en-us</language>
    <atom:link href="{{ "feed.xml" | absURL }}" rel="self" type="application/rss+xml" />
    {{- with index $posts 0 }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- range $posts }}
    <item>
      {{- with .Title }}
      <title>{{ . }}</title>
      {{- end }}
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- range .Params.categories }}
      <category>{{ . }}</category>
      {{- end }}
      <description>{{ .Content | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
